# Credenciales de tu app de Autodesk Platform Services (APS).
# Copia este archivo a ".env" y pega tus llaves reales. NO subas el .env a git.

# Del portal aps.autodesk.com -> tu app "Sonqollay"
APS_CLIENT_ID=pega_aqui_tu_client_id
APS_CLIENT_SECRET=pega_aqui_tu_client_secret

# Nombre del bucket OSS donde se guardan los modelos (minúsculas, único a nivel global).
# Si no existe, el servidor lo crea automáticamente al primer uso.
APS_BUCKET=sonqollay-models-2026

# Puerto del backend (debe coincidir con el callback http://localhost:3000/callback)
PORT=3001

# Origen permitido para CORS (la app Vite de desarrollo)
CLIENT_ORIGIN=http://localhost:5173

# Token secreto que el plugin de Navisworks debe enviar para LEER los datasets
# publicados (GET /api/datasets/:key con Authorization: Bearer <este_valor>).
# Genera uno largo y aleatorio. Si se deja vacío, la lectura queda abierta
# (solo para pruebas). Ver docs/navisworks-plugin/.
SQY_API_TOKEN=

# ─── Descarga del plugin desde el backend (Etapa 1 productización) ───────────
# Estas variables van en el proyecto Vercel (Settings -> Environment Variables).
# Permiten servir el instalador desde /api/plugin/download con repo PRIVADO y un
# token por empresa. Ver docs/navisworks-plugin/DISTRIBUCION.md.

# PAT de GitHub con permiso de LECTURA del repo privado (Contents: read). Lo usa
# el backend para bajar el ZIP de la última Release.
GITHUB_TOKEN=
# Repo y nombre del asset (valen los defaults si no los cambias).
PLUGIN_REPO=nachitomate-cell/dbsonqollay
PLUGIN_ASSET=AuraBIM-instalador.zip

# Registro de empresas (clientes) en JSON, en UNA línea. Cada empresa baja su
# instalador con ?key=<key> y el plugin se autentica con su <token>.
#   PLUGIN_CLIENTS=[{"id":"acme","name":"ACME SpA","key":"dl_xxx","token":"tok_yyy","active":true}]
PLUGIN_CLIENTS=
# Token a inyectar cuando se descarga SIN key (despliegue de un solo cliente).
# Si se deja vacío, se usa SQY_API_TOKEN. Si tampoco hay, se sirve el ZIP tal cual.
PLUGIN_DEFAULT_TOKEN=
