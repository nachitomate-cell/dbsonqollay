<RibbonControl xmlns="clr-namespace:Autodesk.Windows;assembly=AdWindows"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:nw="clr-namespace:Autodesk.Navisworks.Gui.Roamer.AIRLook;assembly=navisworks.gui.roamer"
               x:Uid="AuraBIMRibbon">
  <RibbonTab x:Uid="ID_TabAuraBIM" Id="ID_TabAuraBIM" Title="Aura BIM">
    <RibbonPanel x:Uid="ID_PanelMain">
      <RibbonPanelSource x:Uid="ID_PanelMain_Src" Title="Herramientas">
        <nw:NWRibbonButton x:Uid="ID_AsignarProps" Id="ID_AsignarProps"
                           Size="Large" ShowText="True"
                           Text="Asignar&#xD;&#xA;Propiedades"
                           Orientation="Vertical" />
        <nw:NWRibbonButton x:Uid="ID_AsignarSeleccion" Id="ID_AsignarSeleccion"
                           Size="Large" ShowText="True"
                           Text="Solo&#xD;&#xA;seleccion"
                           Orientation="Vertical" />
        <nw:NWRibbonButton x:Uid="ID_Config" Id="ID_Config"
                           Size="Large" ShowText="True"
                           Text="Configu-&#xD;&#xA;racion"
                           Orientation="Vertical" />
        <nw:NWRibbonButton x:Uid="ID_AcercaDe" Id="ID_AcercaDe"
                           Size="Large" ShowText="True"
                           Text="Acerca&#xD;&#xA;de"
                           Orientation="Vertical" />
      </RibbonPanelSource>
    </RibbonPanel>
  </RibbonTab>
</RibbonControl>
